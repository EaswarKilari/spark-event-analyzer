{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AzureIdentity": {
    "ManagedIdentityClientId": "<managed-identity-client-id>"
  },
  "SparkHistory": {
    "TimeoutSeconds": 60,
    "DefaultPlatform": "Generic",
    "HDInsight": {
      "BaseUrlTemplate": "https://{cluster}/sparkhistory",
      "Username": "",
      "Password": "",
      "UseEventLog": true,
      "EventLogMaxBytes": 26214400,
      "KeyVault": {
        "VaultUri": "",
        "SecretName": "",
        "CacheMinutes": 10
      }
    },
    "Synapse": {
      "BaseUrlTemplate": "https://{workspace}.dev.azuresynapse.net/sparkhistory/{sparkPool}/livyid/{livyId}",
      "Scope": "https://dev.azuresynapse.net/.default"
    },
    "Generic": {
      "BaseUrl": "http://localhost:18080",
      "AuthScope": ""
    }
  },
  "Agent": {
    "Provider": "Foundry"
  },
  "Mcp": {
    "AzureDevOps": {
      "Enabled": false,
      "Url": "https://mcp.dev.azure.com/msazure",
      "Scope": "https://mcp.dev.azure.com/.default",
      "ClientId": "04b07795-8ddb-461a-bbee-02f9e1bf7b46",
      "SpaClientId": "37d94289-0f54-435d-8430-21b1cbc3921d",
      "TenantId": "<tenant-id>",
      "AuthMode": "Interactive",
      "Toolsets": "repos",
      "ReadOnly": true
    }
  },
  "AzureOpenAI": {
    "Endpoint": "",
    "Deployment": "",
    "ApiKey": ""
  },
  "Foundry": {
    "ProjectEndpoint": "https://<your-ai-services>.services.ai.azure.com/api/projects/<your-foundry-project>",
    "Deployment": "gpt-5",
    "AgentId": ""
  },
  "CodeSearch": {
    "SearchEndpoint": "https://<your-search-service>.search.windows.net",
    "IndexName": "code-index",
    "EmbeddingEndpoint": "https://<your-ai-services>.cognitiveservices.azure.com/",
    "EmbeddingDeployment": "text-embedding-3-large",
    "Dimensions": 1536,
    "DefaultK": 8
  }
}

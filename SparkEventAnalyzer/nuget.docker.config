<?xml version="1.0" encoding="utf-8"?>
<!--
  NuGet config used ONLY inside the container/ACR build. It clears inherited sources and
  restores straight from nuget.org, which is reachable from Azure/ACR (unlike the corp box,
  where only the private ADO feed works). This avoids needing ADO feed credentials in the
  image build. Do not use this file for local dev restore.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
